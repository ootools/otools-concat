    "test": "node --test scripts/*.test.mjs",
    "test:src": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "market:preflight": "node scripts/publish-market.mjs preflight",
    "smoke": "node scripts/smoke-concatd.mjs"
  },
